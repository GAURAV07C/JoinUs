@baseUrl = http://127.0.0.1:3001

# ============================================================
# Test Admin Credentials (created by test-db.ts script):
#   Email: admin@test.com
#   Password: Admin@123
# ============================================================

### NextAuth - Get CSRF Token
# @name getCsrfToken
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

### NextAuth - Sign In (Credentials)
# Use the CSRF token from the previous request
# @name signIn
POST {{baseUrl}}/api/auth/signin/credentials
Content-Type: application/x-www-form-urlencoded

csrfToken={{getCsrfToken.response.body.csrfToken}}&email=admin@test.com&password=Admin@123&role=ADMIN&redirect=false&callbackUrl=http://127.0.0.1:3001/dashboard

### NextAuth - Get Session
# @name session
GET {{baseUrl}}/api/auth/session
Accept: application/json

### NextAuth - Sign Out
# @name signOut
POST {{baseUrl}}/api/auth/signout
Content-Type: application/x-www-form-urlencoded

csrfToken={{getCsrfToken.response.body.csrfToken}}&redirect=false&callbackUrl=http://127.0.0.1:3001/

### NextAuth - Providers
# @name providers
GET {{baseUrl}}/api/auth/providers
Accept: application/json
